{
  "name": "@playa-post/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/node/main.js",
  "scripts": {
    "dev": "tsx watch src/entrypoints/http/main.ts",
    "build": "tsup",
    "build:node": "TSUP_TARGET=node tsup",
    "build:cloudflare": "TSUP_TARGET=cloudflare tsup",
    "start": "node dist/node/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@playa-post/configuration": "workspace:*",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "tsx": "4.23.1"
  }
}
