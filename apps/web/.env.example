# Every key `apps/web` reads, names and placeholders only — never a value.
# Vite exposes exactly the `VITE_`-prefixed keys to the browser bundle, so anything
# here is public by construction. A secret must never appear in this file or in any
# `.env` Vite loads (addendum §17; `docs/engineering/secrets.md` holds names, paths,
# and retrieval steps for the ones that are secret).

# Where the dev/preview server proxies `/trpc` to. Read by `vite.config.ts` in Node,
# not by the browser bundle — the app itself always calls the relative path `/trpc`,
# which is why the API needs no CORS layer to be driven by a browser.
VITE_API_BASE_URL=http://127.0.0.1:3000

# The Supabase project the sign-in screen authenticates against. A project ref is a
# public identifier, and this line decides whose users the app will accept
# (ADR-0011). Absent in a local build, the sign-in screen says so rather than
# failing at the first click.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase's anon key: a publishable, RLS-bound key, not a secret — but still not
# committed with a value, because the value names a specific project.
VITE_SUPABASE_ANON_KEY=<anon-key>
