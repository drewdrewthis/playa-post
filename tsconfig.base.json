{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Distinguishes "absent" from "present and undefined". Enabled at M1 because
    // it is the one strictness flag that becomes prohibitively expensive later:
    // every optional-property write in the codebase turns into a candidate error.
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "noEmit": true,
    "types": [],

    // Local-only speedup: `tsc --noEmit` still writes a `.tsbuildinfo` (verified
    // against the pinned TS 6.0.3 — noEmit does not block incremental in this
    // config shape) and reads it back on the next run to skip unchanged files.
    // No `composite` — that implies declaration emit, which this repo never wants.
    // Each leaf tsconfig sets its own `tsBuildInfoFile` so projects don't collide;
    // *.tsbuildinfo is gitignored and CI checks out fresh every run, so this
    // cannot change what CI enforces or mask a CI failure.
    "incremental": true
  }
}
