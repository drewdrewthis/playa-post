{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": ["tests/**/*.ts", "vitest.config.ts", "playwright.config.ts"],
  // Deliberately-violating architecture fixtures, in three roots because they answer
  // to three different tools: `__fixtures__/` is dependency-cruiser's (and
  // `boundaries.fitness.test.ts` asserts every directory in it is named after a
  // dependency-cruiser rule, so nothing else may live there), `sql-fixtures/` is the
  // `no-sql-outside-persistence` walker's, and `csprng-fixtures/` is the
  // `invite-token-csprng` walker's. Type-checking any of them would invite someone to
  // "fix" the violation and silently disarm the rule.
  "exclude": [
    "tests/fitness/__fixtures__/**",
    "tests/fitness/sql-fixtures/**",
    "tests/fitness/csprng-fixtures/**"
  ]
}
