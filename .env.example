# Mirrors packages/configuration/src/environment-schema.ts — keep the two
# in sync when either changes.
#
# Every key below already has a safe default, so the server runs with none
# of these set. Copy this file to .env and override only what you need to
# change locally.
#
# Names and safe example values only. Real secrets are never read through
# this file or @playa-post/configuration — see docs/engineering/secrets.md.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
