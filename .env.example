# Mirrors packages/configuration/src/environment-schema.ts — keep the two
# in sync when either changes.
#
# Names and placeholder values only. This file never carries a real secret,
# and neither does anything @playa-post/configuration reads from source
# control — see docs/engineering/secrets.md for where values actually live.

# --- Optional. Every key below has a safe default; override only what you
# --- need to change locally.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# How many days a soft-deleted row is kept before the purge hard-deletes it
# (issue #169): a removed bulletin's archived_at, a deleted saved view's
# deleted_at. At least 1 — a zero or negative window would purge rows the
# moment somebody deleted them, which is a hard delete wearing a sweep's name.
# Defaulted because a retention window names no external system: there is no
# wrong-but-plausible value that could point this deployment at somebody
# else's data. Not upper-bounded; a longer policy is a legitimate choice.
PURGE_RETENTION_DAYS=30

# --- Required. The server exits non-zero at boot without these, naming the
# --- key and never its value (M1-AC10). They have no defaults on purpose:
# --- a default that works in production is a secret in source control
# --- (architecture-addendum §17), and a default that names someone else's
# --- Supabase project is worse — it would silently accept that project's
# --- users, which looks exactly like a working login.

# The database user MUST be `app_rw` — the non-owning, NOBYPASSRLS role
# (ADR-0002 §2). Connecting as the owner or a superuser silently disables
# FORCE ROW LEVEL SECURITY for every query, and nothing else would notice.
# Locally: the `DB URL` printed by `pnpm db:start`, with the role swapped.
DATABASE_URL=

# The Supabase project's base API URL — https://<project-ref>.supabase.co.
# NOT a secret: a project ref is a public identifier and appears in every
# request the browser makes. Still required, because the server derives the
# JWKS endpoint from it and verifies every access token against the keys
# published there (ADR-0011). Locally: the `API URL` printed by
# `pnpm db:start`.
SUPABASE_URL=

# --- Optional, and ALL-OR-NONE. Set every one of the three or none of them;
# --- a partial set fails at boot naming the missing keys, because a server
# --- that looks configured and cannot sign a push fails inside the flush's
# --- receipt transaction, where the only symptom is a window that rolls back
# --- forever. With none set, the server boots on the unconfigured transport,
# --- logs that the grouping-window flush is not scheduled, and accumulates
# --- matches as `pending` rows — the deliberate M2 state.

# The VAPID application server key pair and contact (RFC 8292). The PUBLIC key
# is not a secret — the browser subscribes with it, and apps/web ships the same
# string as VITE_VAPID_PUBLIC_KEY, so the two must be the same value or every
# subscription this server is handed is one it cannot push to. The PRIVATE key
# is a secret. CONTACT is a `mailto:` or `https:` URI a push service can reach
# the operator at; `web-push` is the authority on the accepted forms.
# Generate a pair with
# `pnpm --filter @playa-post/server exec web-push generate-vapid-keys`
# (the CLI ships with the library, which is a server dependency — it does not
# resolve from the workspace root). The deployed values live in 1Password
# (docs/engineering/secrets.md), never here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=
