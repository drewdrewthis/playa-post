# Mirrors packages/configuration/src/environment-schema.ts — keep the two
# in sync when either changes.
#
# Names and placeholder values only. This file never carries a real secret,
# and neither does anything @playa-post/configuration reads from source
# control — see docs/engineering/secrets.md for where values actually live.

# --- Optional. Every key below has a safe default; override only what you
# --- need to change locally.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# --- Required. The server exits non-zero at boot without these, naming the
# --- key and never its value (M1-AC10). They have no defaults on purpose:
# --- a default that works in production is a secret in source control
# --- (architecture-addendum §17), and a default that names someone else's
# --- Supabase project is worse — it would silently accept that project's
# --- users, which looks exactly like a working login.

# The database user MUST be `app_rw` — the non-owning, NOBYPASSRLS role
# (ADR-0002 §2). Connecting as the owner or a superuser silently disables
# FORCE ROW LEVEL SECURITY for every query, and nothing else would notice.
# Locally: the `DB URL` printed by `pnpm db:start`, with the role swapped.
DATABASE_URL=

# The Supabase project's base API URL — https://<project-ref>.supabase.co.
# NOT a secret: a project ref is a public identifier and appears in every
# request the browser makes. Still required, because the server derives the
# JWKS endpoint from it and verifies every access token against the keys
# published there (ADR-0011). Locally: the `API URL` printed by
# `pnpm db:start`.
SUPABASE_URL=
